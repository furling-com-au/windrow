{
  // Windrow — static deployment to Cloudflare Workers (assets-only, no server code).
  // Deploy: npm run build:app && npx wrangler deploy
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "windrow",
  "compatibility_date": "2026-08-01",
  "assets": {
    "directory": "./app/dist",
    "not_found_handling": "single-page-application"
  }
}
